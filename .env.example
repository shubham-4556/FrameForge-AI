# ─── Core ────────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
APP_URL=http://localhost:3000
API_PORT=4000
API_INTERNAL_URL=http://localhost:4000
DATABASE_URL=postgresql://frameforge:frameforge@localhost:5432/frameforge?schema=public
REDIS_URL=redis://localhost:6379

# Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-a-64-character-random-hex-secret
SIGNING_SECRET=replace-with-another-64-character-random-hex-secret

# ─── Object storage ──────────────────────────────────────────────────────────
# local = filesystem (development). s3 = any S3-compatible store (production).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./.data/storage
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=frameforge
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# ─── Media tooling ───────────────────────────────────────────────────────────
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
FFMPEG_FONT=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
MAX_UPLOAD_MB=512
MAX_RENDER_MINUTES=30
RENDER_TIMEOUT_SECONDS=900
WORKER_CONCURRENCY=1

# ─── AI providers ────────────────────────────────────────────────────────────
# mock = deterministic, clearly watermarked local previews. openai = real APIs.
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
OPENAI_TRANSCRIBE_MODEL=whisper-1

# ─── Email (verification / password reset) ───────────────────────────────────
# log = write links to the server log (development only)
MAIL_DRIVER=log
MAIL_FROM="FrameForge AI <no-reply@frameforge.ai>"
SMTP_URL=

# ─── Billing (optional) ──────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_STUDIO=

# ─── Web ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=FrameForge AI
NEXT_PUBLIC_SHOW_DEMO_CREDENTIALS=true
