generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WorkspaceRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

enum Plan {
  FREE
  PRO
  STUDIO
}

enum ProjectStatus {
  DRAFT
  PROCESSING
  READY
  FAILED
  ARCHIVED
}

enum MediaKind {
  VIDEO
  IMAGE
  AUDIO
  FONT
}

enum AssetStatus {
  UPLOADING
  PROCESSING
  READY
  FAILED
  DELETED
}

enum AiJobKind {
  TEXT_TO_VIDEO
  SCRIPT
  STORYBOARD
  IMAGE_TO_VIDEO
  TRANSCRIPTION
  TEXT_TO_SPEECH
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELED
}

enum ExportStatus {
  READY
  FAILED
  EXPIRED
  DELETED
}

enum UsageKind {
  RENDER_SECONDS
  AI_CREDITS
  STORAGE_BYTES
  EXPORT_COUNT
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String
  emailVerifiedAt DateTime?
  avatarUrl       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  accounts        Account[]
  sessions        Session[]
  verificationTokens EmailVerificationToken[]
  passwordResetTokens PasswordResetToken[]
  ownedWorkspaces Workspace[] @relation("WorkspaceOwner")
  memberships     WorkspaceMember[]
  createdProjects Project[]  @relation("ProjectCreator")
  uploadedAssets  MediaAsset[] @relation("AssetUploader")
  aiJobs          AiGenerationJob[]
  renderJobs      RenderJob[]
  revisions       ProjectRevision[]
  usageRecords    UsageRecord[]
  auditLogs       AuditLog[]
  workspaceInvites WorkspaceMember[] @relation("InvitedBy")

  deletedAt       DateTime?

  @@index([deletedAt])
}

model Account {
  id                String   @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  passwordHash      String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  lastUsedAt DateTime @default(now())
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Workspace {
  id                 String   @id @default(cuid())
  name               String
  slug               String   @unique
  ownerId            String
  plan               Plan     @default(FREE)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  owner       User              @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members     WorkspaceMember[]
  projects    Project[]
  assets      MediaAsset[]
  aiJobs      AiGenerationJob[]
  renderJobs  RenderJob[]
  exports     Export[]
  usage       UsageRecord[]
  auditLogs   AuditLog[]
  subscription Subscription?

  @@index([ownerId])
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole
  invitedById String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  invitedBy User?     @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model Project {
  id           String        @id @default(cuid())
  workspaceId  String
  createdById  String
  title        String
  description  String?
  status       ProjectStatus @default(DRAFT)
  aspectRatio  String        @default("16:9")
  fps          Int           @default(30)
  durationMs   Int           @default(0)
  thumbnailKey String?
  version      Int           @default(1)
  lastEditedAt DateTime      @default(now())
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?

  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy   User              @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: Restrict)
  revisions   ProjectRevision[]
  assets      MediaAsset[]
  aiJobs      AiGenerationJob[]
  renderJobs  RenderJob[]
  exports     Export[]
  usage       UsageRecord[]

  @@index([workspaceId, updatedAt])
  @@index([workspaceId, status])
  @@index([deletedAt])
}

model ProjectRevision {
  id          String   @id @default(cuid())
  projectId   String
  revision    Int
  document    Json
  label       String?
  createdById String
  createdAt   DateTime @default(now())

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User    @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([projectId, revision])
  @@index([projectId, createdAt])
}

model MediaAsset {
  id            String      @id @default(cuid())
  workspaceId   String
  projectId     String?
  uploadedById  String?
  kind          MediaKind
  status        AssetStatus @default(UPLOADING)
  originalName  String
  storageKey    String      @unique
  mimeType      String
  sizeBytes     BigInt      @default(0)
  durationMs    Int?
  width         Int?
  height        Int?
  hasAudio      Boolean     @default(false)
  thumbnailKey  String?
  mock          Boolean     @default(false)
  metadata      Json?
  failureReason String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  deletedAt     DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  uploadedBy User?    @relation("AssetUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([workspaceId, kind, status])
  @@index([projectId])
  @@index([deletedAt])
}

model AiGenerationJob {
  id              String     @id @default(cuid())
  workspaceId     String
  projectId       String?
  createdById     String
  kind            AiJobKind
  provider        String
  model           String?
  prompt          String?
  script          String?
  style           String?
  aspectRatio     String     @default("16:9")
  durationSeconds Int        @default(15)
  resolution      String     @default("1080p")
  params          Json?
  status          JobStatus  @default(QUEUED)
  progress        Int        @default(0)
  mock            Boolean    @default(false)
  result          Json?
  errorCode       String?
  errorMessage    String?
  idempotencyKey  String?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy User      @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, createdAt])
  @@index([projectId])
  @@index([status])
}

model RenderJob {
  id              String     @id @default(cuid())
  workspaceId     String
  projectId       String
  requestedById   String
  revision        Int
  presetId        String?
  status          JobStatus  @default(QUEUED)
  progress        Int        @default(0)
  settings        Json
  outputKey       String?
  outputSizeBytes BigInt?
  durationMs      Int?
  width           Int?
  height          Int?
  errorCode       String?
  errorMessage    String?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requestedBy User    @relation(fields: [requestedById], references: [id], onDelete: Restrict)
  export      Export?

  @@index([workspaceId, createdAt])
  @@index([projectId])
  @@index([status])
}

model Export {
  id            String       @id @default(cuid())
  renderJobId   String       @unique
  workspaceId   String
  projectId     String
  storageKey    String
  filename      String
  format        String       @default("mp4")
  sizeBytes     BigInt       @default(0)
  durationMs    Int?
  width         Int?
  height        Int?
  status        ExportStatus @default(READY)
  downloadCount Int          @default(0)
  expiresAt     DateTime?
  createdAt     DateTime     @default(now())

  renderJob RenderJob @relation(fields: [renderJobId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([projectId])
}

model Subscription {
  id                     String    @id @default(cuid())
  workspaceId            String    @unique
  plan                   Plan      @default(FREE)
  status                 String    @default("active")
  provider               String    @default("internal")
  externalCustomerId     String?
  externalSubscriptionId String?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean   @default(false)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model UsageRecord {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String?
  projectId   String?
  kind        UsageKind
  quantity    BigInt
  metadata    Json?
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([workspaceId, kind, createdAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  workspaceId String?
  actorId     String?
  action      String
  targetType  String?
  targetId    String?
  ip          String?
  userAgent   String?
  metadata    Json?
  createdAt   DateTime @default(now())

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor     User?      @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
}
