{
  "name": "frameforge-ai",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/web",
    "packages/shared"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@frameforge/web",
    "dev:web": "npm run dev --workspace=@frameforge/web",
    "dev:api": "npm --prefix apps/api run dev",
    "dev:worker": "npm --prefix apps/worker run dev",
    "build": "npm run build --workspace=@frameforge/web",
    "build:packages": "npm run build --workspace=@frameforge/shared && npm --prefix packages/db run build",
    "start": "npm run start --workspace=@frameforge/web",
    "vercel-build": "npm run build --workspace=@frameforge/shared && npm run build --workspace=@frameforge/web"
  },
  "dependencies": {
    "@types/node": "^26.6.5",
    "bullmq": "^6.5.1",
    "dotenv": "^18.0.9",
    "ioredis": "^6.0.0",
    "next": "15.5.28"
  }
}
