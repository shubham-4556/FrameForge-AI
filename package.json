{
  "name": "frameforge-ai",
  "version": "1.0.0",
  "private": true,
  "description": "FrameForge AI \u2014 AI-native video creation and editing platform",
  "packageManager": "pnpm@10.9.3",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "pnpm build:packages && concurrently -k -n api,worker,web -c magenta,cyan,green \"pnpm --filter @frameforge/api dev\" \"pnpm --filter @frameforge/worker dev\" \"pnpm --filter @frameforge/web dev\"",
    "dev:web": "pnpm --filter @frameforge/web dev",
    "dev:api": "pnpm --filter @frameforge/api dev",
    "dev:worker": "pnpm --filter @frameforge/worker dev",
    "build": "pnpm -r build",
    "build:packages": "pnpm --filter @frameforge/shared build && pnpm --filter @frameforge/db generate && pnpm --filter @frameforge/db build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r --if-present test",
    "test:unit": "pnpm --filter @frameforge/shared test && pnpm --filter @frameforge/worker test",
    "test:api": "pnpm --filter @frameforge/api test",
    "test:e2e": "playwright test",
    "db:generate": "pnpm --filter @frameforge/db generate",
    "db:migrate": "pnpm --filter @frameforge/db migrate:deploy",
    "db:migrate:dev": "pnpm --filter @frameforge/db migrate:dev",
    "db:seed": "pnpm --filter @frameforge/db seed",
    "db:studio": "pnpm --filter @frameforge/db studio",
    "setup": "pnpm build:packages && pnpm db:migrate && pnpm db:seed"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.18.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^15.15.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "prettier-plugin-tailwindcss": "^0.6.14"
  }
}
