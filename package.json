{
  "name": "frameforge-ai",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": "9.15.9"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "start": "pnpm -r --parallel start",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @frameforge/db prisma:generate",
    "db:migrate": "pnpm --filter @frameforge/db prisma:migrate",
    "db:push": "pnpm --filter @frameforge/db prisma:push",
    "db:studio": "pnpm --filter @frameforge/db prisma:studio"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
