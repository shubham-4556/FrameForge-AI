{
  "name": "frameforge-ai",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace=@frameforge/web & npm run dev --workspace=@frameforge/api & npm run dev --workspace=@frameforge/worker",
    "build": "npm run build --workspace=@frameforge/web",
    "start": "npm run start --workspace=@frameforge/web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
